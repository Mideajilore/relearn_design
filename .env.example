# Copy to `.env.local` and fill in. Never commit the real file.
# Leave these unset and the app runs local-only, exactly as v1 did.

# Supabase project URL — dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (NOT the service_role key — that one must
# never reach the browser)
VITE_SUPABASE_ANON_KEY=your-anon-key

# A fixed string that tags your rows. Both your devices must use the same
# value. Generate one with:  openssl rand -hex 16
# This is a shared secret, not authentication — see supabase/schema.sql.
VITE_OWNER_KEY=your-owner-key
